{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  // Enable once the ahmadsaad.dev zone is active on the Cloudflare account:
  // "routes": [
  //   { "pattern": "ahmadsaad.dev", "custom_domain": true },
  //   { "pattern": "www.ahmadsaad.dev", "custom_domain": true }
  // ],
  "observability": {
    "enabled": true
  }
}
